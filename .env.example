# ── Copy this file to .env.local and fill in the values. Never commit .env.local. ──

# Neon Postgres (free tier) — pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# App
APP_URL="http://localhost:3010"
APP_NAME="FitCommand"
APP_TIMEZONE="Asia/Kolkata"   # timezone used for "today" in logs and schedules

# Sessions — generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Single admin account (the only email that receives the ADMIN role)
ADMIN_EMAIL="sid.kumar2345@gmail.com"

# Brevo transactional email (free tier, 300/day) — needed from Phase 2
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="FitCommand"

# AI assistant (free tiers) — needed from Phase 6
AI_PROVIDER="gemini"          # gemini | groq
GEMINI_API_KEY=""             # aistudio.google.com — free, do not attach billing
GEMINI_MODEL="gemini-3.6-flash"
GROQ_API_KEY=""               # optional fallback — console.groq.com
GROQ_MODEL="llama-3.3-70b-versatile"

# Protects /api/cron/daily-digest — generate with: openssl rand -hex 32
CRON_SECRET=""

# In-process minute scheduler for daily motivation emails (set to false on serverless hosts)
IN_PROCESS_SCHEDULER="true"
